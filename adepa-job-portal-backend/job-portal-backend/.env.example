# Copy this file to .env and fill in your real values.
# Never commit the actual .env file — it's already in .gitignore.
#
# The server prints a warning at startup for any of these it can't find, so if a
# feature silently does nothing, check that log first.

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Get this from https://cloud.mongodb.com -> your cluster -> Connect -> Drivers
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/adepa?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# JWT secret — use a long, random string. You can generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Frontend URL. Used for CORS and to build the links inside emails, so in
# production this must be the real deployed frontend URL, not localhost.
CLIENT_URL=http://localhost:5173

# ---- Brevo (transactional email) ----
# Sends verification links, password resets, and application status updates.
#
# EMAIL_USER is the "from" address and MUST be one you have verified as a Sender
# in Brevo (Senders, Domains, IPs -> Senders), or Brevo rejects every send.
# Note this is an email address, not a password — an older version of this file
# listed EMAIL_PASS here, which is why sends could fail with no obvious cause.
EMAIL_USER=your_verified_sender_email@example.com

# Brevo -> profile icon -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=your_brevo_api_key_here

# ---- Google Gemini ----
# Powers the AI resume-fit analysis shown to employers.
# aistudio.google.com/apikey -> Create API Key (free, no billing needed)
GEMINI_API_KEY=your_gemini_api_key_here
